{"d":"Improved top (interactive process viewer)","o":[{"n":["--help","-h"],"d":"Show help for htop"},{"n":["--no-color","-C"],"d":"Use a monochrome color scheme"},{"n":["--delay","-d"],"d":"Delay between updates, in tenths of sec","a":[{"k":"enum","t":"delay","v":["10","1","60"]}]},{"n":["--filter","-F"],"d":"Filter commands","a":[{"k":"text","t":"filter"}]},{"n":["--highlight-changes","-H"],"d":"Highlight new and old processes","a":[{"k":"enum","t":"delay","v":["10","1","60"],"o":1}]},{"n":["--no-mouse","-M"],"d":"Disable the mouse"},{"n":["--pid","-p"],"d":"Show only the given PIDs","a":[{"k":"text","t":"PID","m":1}]},{"n":["--sort-key","-s"],"d":"Sort by COLUMN in list view","a":[{"k":"text","t":"column"}]},{"n":["--tree","-t"],"d":"Show the tree view"},{"n":["--user","-u"],"d":"Show only processes for a given user (or $USER)","a":[{"k":"enum","t":"user","v":["$USER"],"o":1}]},{"n":["--no-unicode","-U"],"d":"Do not use unicode but plain ASCII"},{"n":["--version","-V"],"d":"Print version info"}]}

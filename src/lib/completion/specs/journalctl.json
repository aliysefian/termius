{"d":"Query the systemd journal","o":[{"n":["-u","--unit"],"d":"Show messages from this unit","a":[{"k":"text","t":"unit"}]},{"n":["-f","--follow"],"d":"Follow new messages"},{"n":["-n","--lines"],"d":"How many of the newest lines to show","a":[{"k":"text","t":"lines"}]},{"n":["-b","--boot"],"d":"Show messages from this boot","a":[{"k":"text","t":"boot","o":1}]},{"n":["-p","--priority"],"d":"Only this priority or worse","a":[{"k":"enum","t":"priority","v":[["emerg","System is unusable"],["alert","Act immediately"],["crit","Critical"],["err","Errors"],["warning","Warnings"],["notice","Normal but significant"],["info","Informational"],["debug","Debug"]]}]},{"n":["-S","--since"],"d":"Show entries since a date or time","a":[{"k":"text","t":"date"}]},{"n":["-U","--until"],"d":"Show entries until a date or time","a":[{"k":"text","t":"date"}]},{"n":["-r","--reverse"],"d":"Newest first"},{"n":["-k","--dmesg"],"d":"Kernel messages only"},{"n":["-g","--grep"],"d":"Only entries whose message matches a pattern","a":[{"k":"text","t":"pattern"}]},{"n":["-o","--output"],"d":"How to print each entry","a":[{"k":"enum","t":"format","v":["short","short-iso","short-precise","cat","json","json-pretty","verbose"]}]},{"n":"--no-pager","d":"Do not pipe the output into a pager"},{"n":"--disk-usage","d":"Show how much disk the journal uses"},{"n":"--vacuum-time","d":"Delete entries older than this","a":[{"k":"text","t":"time"}]},{"n":"--vacuum-size","d":"Shrink the journal to this size","a":[{"k":"text","t":"size"}]}]}
